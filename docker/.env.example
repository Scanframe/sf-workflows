# Runner registration token, manually generated from the GitHub UI.
# This runner is configured for a single repository (scanframe-org/sf-gitlab-devops).
#
# How to generate the token:
# 1. Go to: https://github.com/scanframe-org/sf-gitlab-devops/settings/actions/runners/new
#    (requires admin access to the repository)
# 2. Select Linux x64
#    The page shows download/config.sh commands. Do NOT run them: nothing is installed on the host,
#    the Docker image already contains the runner and runs config.sh by itself.
# 3. Only copy the token: the value after '--token' in the './config.sh --url ... --token XXXX' line
# 4. Paste it below
#
# Note: The token expires after 1 hour and can be used only once.
# With EPHEMERAL mode, the runner needs a new token on each container re-creation.
# For persistent runners, remove EPHEMERAL and mount /runner/data volume.
GH_RUNNER_TOKEN=your-registration-token-here
