# Runner registration token, manually generated from the GitHub UI.
# This runner is configured for a single repository (scanframe-org/sf-gitlab-devops).
#
# How to generate the token:
# 1. Go to: https://github.com/<your-organisation>/sf-gitlab-devops/settings/actions/runners/new
#    (requires admin access to the repository)
# 2. Select Linux x64
#    The page shows download/config.sh commands. Do NOT run them: nothing is installed on the host,
#    the Docker image already contains the runner and runs config.sh by itself.
# 3. Only copy the token: the value after '--token' in the './config.sh --url ... --token XXXX' line
# 4. Paste it below
#
# Note: The token expires after 1 hour and can be used only once.
# With EPHEMERAL mode, the runner needs a new token on each container re-creation.
# For persistent runners, remove EPHEMERAL and mount /runner/data volume.
GITHUB_RUNNER_TOKEN=your-registration-token-here
GITHUB_RUNNER_NAME="runner-01"
GITHUB_REPO_URL="https://github.com/scanframe-org/sf-trial-devops"

# Organisation self-hosted runner using a PAT (Personal Access Token).
# 1. Go to https://github.com/settings/personal-access-tokens
# 2. Fill in the form:
#    - Token name: e.g. 'build-runner'
#    - Expiration: pick a date. Fine-grained tokens must expire (the maximum is 1 year, depending on org policy). Put
#      a reminder in your calendar, because the runner will fail to restart after expiry.
#    - Resource owner: select '<your-organisation>', not your personal account. If the org isn't in the dropdown, an
#      owner has to allow fine-grained PATs first (see below).
#    - Repository access: choose 'Public repositories' (the minimum). It doesn't matter for org runners, since the
#      runner permission is org-level.
# 3 Paste it below.
GITHUB_ORG="scanframe-org"
GITHUB_PAT="<your-self-hosted-finegraind-pat-here>"
GITHUB_RUNNER_NAME="runner-01"
